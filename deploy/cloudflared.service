[Unit]
Description=Cloudflare Tunnel: claudino.macch.ai -> claudino desktop hub (127.0.0.1:8766)
After=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/cloudflared --no-autoupdate tunnel --config %h/.cloudflared/claudino.yml run
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
