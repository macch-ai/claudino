# claudino settings. Copy to ~/.config/claude-relay/env (mode 600); systemd loads it.
# Values are plain KEY=value lines: no quotes, no shell expansion. "~" is expanded by claudino.

# --- Required -----------------------------------------------------------------
# Written by scripts/set-tokens.sh.
SLACK_APP_TOKEN=xapp-...
SLACK_BOT_TOKEN=xoxb-...

# Slack user IDs allowed to talk to claudino, comma separated. Empty: claudino ignores everyone.
CLAUDINO_ALLOWED_USERS=U01AAAAAAAA,U01BBBBBBBB

# --- Claude Code runs ---------------------------------------------------------
# Where sessions start (put your repository checkouts here). Default: ~
CLAUDINO_WORKDIR=~/code
# bypassPermissions (default) runs claude with --dangerously-skip-permissions.
# Any other value is passed as --permission-mode (auto, acceptEdits, default, plan).
CLAUDINO_PERMISSION_MODE=bypassPermissions
# Extra PATH entries for sessions, colon separated. Default: ~/.local/bin
CLAUDINO_EXTRA_PATH=~/.local/bin
# Unix user that runs Claude through sudo, so sessions cannot read this file's tokens.
# Set by deploy/setup-relay-user.sh. Default: none (Claude runs as the relay's user).
CLAUDINO_RUN_AS=
# Text appended to every relayed request. Default: none.
# Quote values with spaces (CLAUDINO_PROMPT_SUFFIX="caveman mode") so the file also works with `source`.
CLAUDINO_PROMPT_SUFFIX=
# Status shown under the thread while a run works ("claudino is working on it...").
# Set to off to hide it. Default: is working on it...
CLAUDINO_STATUS=
# Haiku writes rotating status lines for each request. These fallback lines, separated by "|" (max 10),
# show until Haiku's are ready or when it fails. Default: none (the status text alone).
CLAUDINO_LOADING_MESSAGES=
# Seconds before a run is killed. Default: 3000
CLAUDINO_TIMEOUT_SECONDS=3000
# Claude runs working at once; requests in other threads wait for a free slot. Default: 3
CLAUDINO_MAX_RUNS=3
# Days to keep files downloaded from Slack threads; 0 keeps them forever. Default: 14
CLAUDINO_FILES_KEEP_DAYS=14

# --- Sentry alert hand-over (optional; leave empty to turn off) ----------------
# Channel where the Sentry app posts alerts, and the Sentry app's bot user ID.
CLAUDINO_ALERT_CHANNEL=
CLAUDINO_ALERT_BOT_USER=
# The /fire endpoint of the Claude Code routine that handles one alert.
CLAUDINO_ALERT_ROUTINE_URL=
# File holding the routine's API token. Default: ~/.config/claude-alert-fire/token
CLAUDINO_ALERT_TOKEN_FILE=
# The Claude app's user ID: mentions of it in the alert channel reach claudino too.
CLAUDINO_CLAUDE_APP_USER=

# --- Paths (rarely changed) -----------------------------------------------------
# CLAUDINO_CONFIG_DIR=~/.config/claude-relay   (instructions.md here is appended to the system prompt)
# CLAUDINO_STATE_DIR=~/.local/state/claude-relay
